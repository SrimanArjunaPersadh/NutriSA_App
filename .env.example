# Copy to .env AT THE PROJECT ROOT. Metro only reads root .env — a key in
# src/.env never reaches the app bundle.

# --- Client (bundled into the app; EXPO_PUBLIC_ prefix is required) ---
# Clerk Dashboard -> API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where the app finds the API. In development this is the SAME permanent ngrok
# domain the Clerk webhook posts to — NOT http://localhost:3000, because the app
# runs on the iPhone and localhost there is the phone.
#
# No trailing slash: the client appends paths like /api/day/today.
#
# Metro inlines EXPO_PUBLIC_* at build time, so changing this needs a Metro
# restart. A running bundle will not pick it up.
EXPO_PUBLIC_API_URL=https://<your-permanent-domain>.ngrok-free.dev

# --- Server (server/, never bundled) ---
# Clerk Dashboard -> API keys
CLERK_SECRET_KEY=sk_test_...
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Neon -> project -> Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# A Neon BRANCH, only for `npm run test:security`. Those tests create users,
# write rows and delete them again — never point this at the main database.
# Neon console -> Branches -> New branch, from `main`, then its pooled string.
TEST_DATABASE_URL=

# Goal bodyweight in kg, used by `npm run seed:profile`.
# Lives here rather than as a literal in the script: it is a real person's real
# target and a committed constant is in git history forever.
SEED_GOAL_WEIGHT_KG=

# Server-side error reporting. Leave empty to keep Sentry off, which is the
# right setting for the dev loop. sendDefaultPii is false in code and must stay
# that way — see server/observability/sentry.ts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Inngest runs against the local dev server; leave the production keys unset.
# Pinned to an explicit 127.0.0.1 URL rather than `1`: the bare form falls back
# to resolving `localhost`, which on Windows can pick a loopback address the
# dev server is not answering on.
INNGEST_DEV=http://127.0.0.1:8288
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# --- Build tooling ---
# Sentry auth token for uploading source maps/debug symbols during builds.
# Generate one at https://sentry.io/orgs/sriman-arjuna-persadh/settings/auth-tokens/
# with scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=
