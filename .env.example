# Copy to .env AT THE PROJECT ROOT. Metro only reads root .env — a key in
# src/.env never reaches the app bundle.

# --- Client (bundled into the app; EXPO_PUBLIC_ prefix is required) ---
# Clerk Dashboard -> API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Server (server/, never bundled) ---
# Clerk Dashboard -> API keys
CLERK_SECRET_KEY=sk_test_...
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Neon -> project -> Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Inngest runs against the local dev server; leave the production keys unset.
INNGEST_DEV=1
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# --- Build tooling ---
# Sentry auth token for uploading source maps/debug symbols during builds.
# Generate one at https://sentry.io/orgs/sriman-arjuna-persadh/settings/auth-tokens/
# with scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=
