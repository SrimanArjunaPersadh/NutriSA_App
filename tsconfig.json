{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@engine": [
        "./packages/engine/src/index.ts"
      ],
      "@engine/*": [
        "./packages/engine/src/*"
      ],
      "@shared": [
        "./packages/shared/src/index.ts"
      ],
      "@shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
